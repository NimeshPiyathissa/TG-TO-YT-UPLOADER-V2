# Normalise everything to LF in the repository.
* text=auto eol=lf

# Force LF in the working tree too (a CRLF in a shell script or unit file breaks it on Linux).
*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.cnf     text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.txt     text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.example text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Makefile  text eol=lf
tgyt      text eol=lf
install.sh text eol=lf

# Binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
